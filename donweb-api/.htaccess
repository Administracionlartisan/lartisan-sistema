Options -Indexes
RewriteEngine On

# Por defecto nada de esta carpeta se sirve por web: configuración, módulos
# internos, documentación, paquetes, volcados ni certificados.
<FilesMatch ".*">
  Require all denied
</FilesMatch>

# Excepciones explícitas: la API y el disparador de respaldo (que además exige
# la clave X-Backup-Key y responde 404 sin ella).
<FilesMatch "^(index|backup)\.php$">
  Require all granted
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php?route=$1 [QSA,L]
